@model List<OnlineFoodOrderingSystem.Models.Food>

@{
    ViewData["Title"] = "Food Management";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold">Food Management</h2>
            <p class="text-muted mb-0">
                Manage all food items in your restaurant.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add New Food
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Food Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var food in Model)
                            {
                                <tr>
                                    <td>@food.FoodId</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(food.ImageUrl))
                                        {
                                            <img src="@food.ImageUrl"
                                                 alt="@food.FoodName"
                                                 style="width:65px;height:55px;object-fit:cover;border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@food.FoodName</strong>
                                    </td>

                                    <td>@food.CategoryName</td>

                                    <td>$@food.Price.ToString("0.00")</td>

                                    <td>
                                        @if (food.IsAvailable)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Unavailable
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@food.FoodId"
                                               class="btn btn-sm btn-info text-white">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@food.FoodId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@food.FoodId"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    No food items found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>

</div>
