@model OnlineFoodOrderingSystem.Models.Food

@{
    ViewData["Title"] = "Delete Food";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Food</h2>
        <p class="text-muted">
            Review the item before confirming deletion.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Warning!</strong>
                Are you sure you want to delete this food item?
                This action cannot be undone.
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-3">
                    <img src="@Model.ImageUrl"
                         alt="@Model.FoodName"
                         style="width:180px;height:140px;object-fit:cover;border-radius:10px;" />
                </div>
            }

            <dl class="row">

                <dt class="col-sm-3">Food ID</dt>
                <dd class="col-sm-9">@Model.FoodId</dd>

                <dt class="col-sm-3">Food Name</dt>
                <dd class="col-sm-9">@Model.FoodName</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">
                    $@Model.Price.ToString("0.00")
                </dd>

                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">
                    @(Model.IsAvailable ? "Available" : "Unavailable")
                </dd>

            </dl>

            <form asp-controller="AdminFoods"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.FoodId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>
