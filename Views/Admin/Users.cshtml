@model IEnumerable<OnlineFoodOrderingSystem.Models.User>

@{
    ViewData["Title"] = "Customer Accounts";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold">Customer Accounts</h2>
            <p class="text-muted mb-0">
                Manage registered customers and their account status.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="Users"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-9">
                        <input type="text"
                               name="searchTerm"
                               value="@ViewBag.SearchTerm"
                               class="form-control"
                               placeholder="Search by name, email or phone..." />
                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-action="Users"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                Registered Customers (@Model.Count())
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No customer accounts were found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th>Registration Date</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th style="min-width: 230px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var customer in Model)
                            {
                                <tr>

                                    <td>@customer.UserId</td>

                                    <td class="fw-semibold">
                                        @customer.FullName
                                    </td>

                                    <td>@customer.Email</td>

                                    <td>
                                        @(customer.Phone ?? "Not provided")
                                    </td>

                                    <td>
                                        @(customer.Address ?? "Not provided")
                                    </td>

                                    <td>
                                        @customer.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @customer.Role
                                        </span>
                                    </td>

                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">

                                            <a asp-controller="Admin"
                                               asp-action="Details"
                                               asp-route-id="@customer.UserId"
                                               class="btn btn-sm btn-primary">
                                                Details
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="Edit"
                                               asp-route-id="@customer.UserId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="ToggleAccountStatus"
                                                  asp-route-id="@customer.UserId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to change this customer account status?');">

                                                @Html.AntiForgeryToken()

                                                @if (customer.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Activate
                                                    </button>
                                                }

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
