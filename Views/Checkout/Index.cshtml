@model List<OnlineFoodOrderingSystem.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
    decimal total = ViewBag.CartTotal is decimal value ? value : 0m;
}

<div class="container py-5">
    <div class="cart-heading">
        <span class="menu-eyebrow">ALMOST THERE</span>
        <h1>Checkout</h1>
        <p>Enter your delivery address to place your order.</p>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="cart-layout">
        <section class="cart-summary">
            <h2>Delivery Details</h2>

            <form asp-controller="Checkout"
                  asp-action="PlaceOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="deliveryAddress" class="form-label">
                        Delivery Address
                    </label>

                    <textarea id="deliveryAddress"
                              name="deliveryAddress"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              required
                              placeholder="Enter your complete delivery address"></textarea>

                    <span class="text-danger">
                        @Html.ValidationMessage("deliveryAddress")
                    </span>
                </div>

                <button type="submit"
                        class="btn cart-orange-button">
                    Confirm Order
                </button>

                <p class="mt-3">
                    <a asp-controller="Cart" asp-action="Index">
                        Return to cart
                    </a>
                </p>
            </form>
        </section>

        <aside class="cart-summary">
            <h2>Order Summary</h2>

            @foreach (var item in Model)
            {
                <div class="summary-row">
                    <span>@item.FoodName × @item.Quantity</span>
                    <span>@item.SubTotal.ToString("N2")</span>
                </div>
            }

            <div class="summary-row summary-total">
                <span>Total</span>
                <span>@total.ToString("N2")</span>
            </div>
        </aside>
    </div>
</div>
