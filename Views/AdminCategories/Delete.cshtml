@model OnlineFoodOrderingSystem.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0">Delete Category</h4>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                <strong>Warning!</strong>
                Are you sure you want to delete this category?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Category ID</dt>
                <dd class="col-sm-9">@Model.CategoryId</dd>

                <dt class="col-sm-3">Category Name</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available."
                        : Model.Description)
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.CategoryId" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Category
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
