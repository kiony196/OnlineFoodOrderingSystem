@model OnlineFoodOrderingSystem.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white py-3">
            <h4 class="mb-0">Category Details</h4>
        </div>

        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-3">Category ID</dt>
                <dd class="col-sm-9">@Model.CategoryId</dd>

                <dt class="col-sm-3">Category Name</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available."
                        : Model.Description)
                </dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.CategoryId"
               class="btn btn-warning">
                Edit Category
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                Back to Categories
            </a>
        </div>
    </div>
</div>
